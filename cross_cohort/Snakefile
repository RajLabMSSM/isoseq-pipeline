# run after every cohort's own pipeline: snakejob_HPC -s Snakefile -c cross_cohort_config.yaml
import os

configfile: "cross_cohort_config.yaml"

SCRIPTS    = os.path.join(os.path.dirname(workflow.basedir), "scripts")
FASTA_SH   = os.path.join(os.path.dirname(os.path.dirname(workflow.basedir)), "salmon-pipeline/scripts/make_transcriptome_fasta.sh")
PYTHON     = "/sc/arion/projects/als-omics/conda/envs/isoseq-pipeline/bin/python"
TAMA       = "/sc/arion/projects/ad-omics/data/software/tama/tama_merge.py"
PYTHON2    = "/sc/arion/projects/als-omics/conda/envs/tama_env/bin/python"
GFFCOMPARE = "/sc/arion/projects/ad-omics/data/software/gffcompare-0.12.10.Linux_x86_64/gffcompare"

OUT     = config["output_dir"]
NAME    = config["output_name"]
cohorts = config["cohorts"]
cohort_args = " ".join("--cohort %s=%s" % kv for kv in cohorts.items())
cohort_prov = {k: v.replace(".isoforms.gtf.gz", "_novel_provenance.tsv") for k, v in cohorts.items()}
cohort_tracking = {k: v.replace(".isoforms.gtf.gz", "_tracking_numbers.tsv") for k, v in cohorts.items()}


rule all:
    input:
        OUT + NAME + ".gtf.gz",
        OUT + NAME + ".fa.gz",
        OUT + "cross_cohort_novel_provenance.tsv",
        OUT + "tracking_numbers_final_numbers.tsv",
        OUT + "cross_cohort_tool_membership_by_cohort.tsv",
        OUT + "tracking_numbers.done"


# the cohorts' SQANTI-passed novels merged at the within-cohort tolerances, then GENCODE appended
rule cross_cohort_union:
    input:
        ref     = config["reference"],
        cohorts = list(cohorts.values())
    output:
        gtf     = temp(OUT + NAME + ".union.gtf"),
        prov    = temp(OUT + "cross_cohort_union_provenance.tsv"),
        summary = OUT + "tracking_numbers_final_numbers.tsv"
    params:
        workdir = OUT + "tama_tmp"
    shell:
        """
        {PYTHON} {SCRIPTS}/cross_cohort_novel_union.py \
        --reference {input.ref} \
        {cohort_args} \
        --novel-source ONT \
        --wobble {config[wobble]} \
        --tes-tol {config[tes_tol]} \
        --ends common_ends \
        --tama-merge {TAMA} \
        --python2 {PYTHON2} \
        --workdir {params.workdir} \
        --prefix XNOVEL \
        --provenance-out {output.prov} \
        --summary-out {output.summary} \
        -o {output.gtf}
        rm -rf {params.workdir}
        """


rule decompress_reference:
    input:
        config["reference"]
    output:
        temp(OUT + "reference.gtf")
    shell:
        "gunzip -c {input} > {output}"


rule cross_cohort_genes:
    input:
        gtf     = OUT + NAME + ".union.gtf",
        prov    = OUT + "cross_cohort_union_provenance.tsv",
        ref     = OUT + "reference.gtf",
        cohorts = list(cohorts.values())
    output:
        gtf  = OUT + NAME + ".gtf.gz",
        prov = OUT + "cross_cohort_novel_provenance.tsv"
    params:
        plain   = OUT + NAME + ".gtf",
        workdir = OUT + "loci_tmp"
    shell:
        """
        {PYTHON} {SCRIPTS}/cross_cohort_novel_genes.py \
        --gtf {input.gtf} \
        --provenance {input.prov} \
        {cohort_args} \
        --reference {input.ref} \
        --gffcompare {GFFCOMPARE} \
        --workdir {params.workdir} \
        --novel-source ONT \
        --prefix XNOVEL \
        --provenance-out {output.prov} \
        -o {params.plain}
        gzip -nf {params.plain}
        rm -rf {params.workdir}
        """


rule cross_cohort_fasta:
    input:
        gtf = OUT + NAME + ".gtf.gz"
    output:
        fa = OUT + NAME + ".fa.gz"
    shell:
        "bash {FASTA_SH} {input.gtf} {config[genome_fasta]} {output.fa}"


# rebuilt every time: XNOVEL ids are renumbered between builds
rule cross_cohort_tool_membership:
    input:
        cross       = OUT + "cross_cohort_novel_provenance.tsv",
        cohort_prov = list(cohort_prov.values())
    output:
        OUT + "cross_cohort_tool_membership_by_cohort.tsv"
    params:
        cohort_args = " ".join("--cohort %s=%s" % kv for kv in cohort_prov.items())
    shell:
        """
        {PYTHON} {SCRIPTS}/cross_cohort_tool_membership_by_cohort.py \
        --cross-provenance {input.cross} {params.cohort_args} \
        -o {output}
        """


rule upsert_tracking:
    input:
        union  = OUT + "tracking_numbers_final_numbers.tsv",
        cohort = list(cohort_tracking.values())
    output:
        done = touch(OUT + "tracking_numbers.done")
    params:
        cohort = " ".join("%s=%s" % kv for kv in cohort_tracking.items())
    shell:
        """
        {PYTHON} {SCRIPTS}/upsert_tracking_numbers.py {config[tracking_numbers]} {config[run_code]} {input.union} {params.cohort}
        """
