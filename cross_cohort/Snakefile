# the pooled stage, run after both cohorts finish discovery: snakejob_HPC -s Snakefile -c cross_cohort_config.yaml
# it merges the 12 assembler gtfs of both cohorts once, runs SQANTI once, and writes GENCODE plus the passed novels
import glob
import os
import yaml

# as in the cohort Snakefile. PS1 is set empty because conda activate reads it and a batch job does not set it
shell.prefix(
    'export PS1=""; '
    'ml anaconda3; '
    'CONDA_BASE=$(conda info --base); '
    'source $CONDA_BASE/etc/profile.d/conda.sh; '
    'module purge; '
    'conda activate isoseq-pipeline; '
)

# the isoseq scripts and workflows are one folder up, the salmon-pipeline gffread wrapper two
ISOSEQ_DIR    = os.path.dirname(workflow.basedir)
PIPELINES_DIR = os.path.dirname(ISOSEQ_DIR)
SCRIPTS       = os.path.join(ISOSEQ_DIR, "scripts")
FASTA_SH      = os.path.join(PIPELINES_DIR, "salmon-pipeline/scripts/make_transcriptome_fasta.sh")
TAMA       = "/sc/arion/projects/ad-omics/data/software/tama/tama_merge.py"                         # Merge transcript models with similar structures
PYTHON2    = "/sc/arion/projects/als-omics/conda/envs/tama_env/bin/python"                          # Python interpreter used to run TAMA
GFFCOMPARE = "/sc/arion/projects/ad-omics/data/software/gffcompare-0.12.10.Linux_x86_64/gffcompare" #Compare assembled transcripts with reference annotations

# every build name comes from run_code, so a new build never overwrites an old one
RUN  = config["run_code"]
OUT  = config["reference_root"] + RUN + "/"
NAME = "isoforms_" + RUN

# each cohort's own config, so this stage reads the same genome, assembler paths and junction files the cohort run used
COHORT_CFG = {}
for cohort_name, cohort_config in config["cohorts"].items():
    with open(cohort_config) as fh:
        COHORT_CFG[cohort_name] = yaml.safe_load(fh)
COHORT_NAMES = sorted(COHORT_CFG)

# stop on an underscore in a cohort name (TAMA's separator) or a cohort config with another run_code
for cohort_name, cfg in COHORT_CFG.items():
    if "_" in cohort_name:
        raise ValueError("cohort name %s carries an underscore" % cohort_name)
    if cfg["run_code"] != RUN:
        raise ValueError("cohort %s has run_code %s, this build is %s" % (cohort_name, cfg["run_code"], RUN))

# the cohorts must agree on genome, annotation and SQANTI evidence files, because one SQANTI run covers them all.
# the positive controls and UCSC genome name default to the hg38 values below
HG38_SANITY_EVENTS = ("UNC13A:chr19:17641557-17642413+17642542-17642844," # because both junctions are on either end of the cryptic exon
                      "STMN2:chr8:79611215-79616821,"
                      "KCNQ2:chr20:63439709-63444658,"
                      "HYOU1:chr11:119052173-119052636,"
                      "NUP93:chr16:56839070-56841704,"
                      "XPNPEP1:chr10:109884149-109888048")
SHARED = {}
for key, default in (("ref_genome", None), ("ref_gtf", None), ("sqanti_cage_peak", None),
                     ("sqanti_polya_motifs", None), ("sanity_event_list", HG38_SANITY_EVENTS),
                     ("ucsc_genome", "hg38")):
    values = {cfg.get(key, default) for cfg in COHORT_CFG.values()}
    if len(values) != 1 or None in values:
        raise ValueError("the cohort configs disagree on %s: %s" % (key, values))
    SHARED[key] = values.pop()
GENOME        = SHARED["ref_genome"] + ".fa"
REF_GTF       = OUT + "reference.gtf"
SANITY_GENES  = "UNC13A,STMN2,KCNQ2,HYOU1,NUP93,XPNPEP1"
SANITY_EVENTS = SHARED["sanity_event_list"]


# the assembler gtfs as (tool, cohort, group, path), at the paths the cohort pipeline writes
def cohort_tool_gtfs(cohort_name, cfg):
    out = cfg["out_folder"] + cfg["run_code"] + "/"
    code = cfg["data_code"]
    rows = []
    for g in cfg["groups"]:
        rows.append(("bambu", cohort_name, g, out + "bambu/%s/%s_%s_extended_annotations.gtf" % (g, code, g)))
        rows.append(("isoquant", cohort_name, g,
                     out + "isoquant/%s/%s_%s/%s_%s.extended_annotation.gtf" % (g, code, g, code, g)))
        rows.append(("stringtie", cohort_name, g, out + "stringtie3/%s/%s_%s.stringtie.gtf" % (g, code, g)))
    return rows


TOOL_GTFS = [row for c in COHORT_NAMES for row in cohort_tool_gtfs(c, COHORT_CFG[c])]


# STAR junction files of both cohorts for SQANTI's short-read support, without exclude_samples (tdpkd TDP-5 and CTRL-4)
def cohort_sj_files(cfg):
    excluded = {x for x in cfg.get("exclude_samples", "").split(",") if x}
    return [f for f in sorted(glob.glob(os.path.join(cfg["junction_folder"], "*.SJ.out.tab")))
            if os.path.basename(f).split(".")[0] not in excluded]


SQANTI_SJ = [f for c in COHORT_NAMES for f in cohort_sj_files(COHORT_CFG[c])]
# SQANTI names each library by its file name, so stop if two cohorts share one
sj_names = [os.path.basename(f) for f in SQANTI_SJ]
if len(set(sj_names)) != len(sj_names):
    raise ValueError("two cohorts share a junction file name: %s" % sorted(sj_names))

# the tracking table is updated only when the config names it
rule all:
    input:
        OUT + NAME + ".gtf.gz",
        OUT + NAME + ".fa.gz",
        OUT + "cross_cohort_novel_provenance.tsv",
        OUT + NAME + "_sanity_genes.tsv",
        OUT + "consensus/" + NAME + "_tool_overlap.tsv",
        OUT + "tracking_numbers_final_numbers.tsv",
        expand(OUT + "tracking_numbers_{cohort}.tsv", cohort=COHORT_NAMES),
        OUT + "sqanti/" + NAME + "_ucsc_hub",
        [OUT + "tracking_numbers.done"] if config.get("tracking_numbers") else []


# gffcompare, SQANTI and the scripts read a plain-text gtf
rule decompress_reference:
    input:
        SHARED["ref_gtf"]
    output:
        temp(REF_GTF)
    shell:
        "gunzip -c {input} > {output}"


# included after rule all, so rule all stays the default target
include: os.path.join(ISOSEQ_DIR, "workflows", "consensus_pipeline.smk")
include: os.path.join(ISOSEQ_DIR, "workflows", "sqanti_pipeline.smk")
