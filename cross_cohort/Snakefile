# The pooled stage of the isoform atlas. Run it after every cohort's own pipeline has finished discovery:
#   snakejob_HPC -s Snakefile -c cross_cohort_config.yaml
# Each cohort runs StringTie, IsoQuant and Bambu on its own reads, because the cohorts differ in flow cell, basecaller
# and library kit. This stage then combines the 12 assembler GTFs of both cohorts, removes the transcripts that carry
# a GENCODE id, merges the rest with tama_merge, classifies the merged models against GENCODE v50 with gffcompare,
# filters them once with SQANTI3 on the short reads of both cohorts, and writes GENCODE plus the passed novels.
import glob
import os
import yaml

# Load the conda shell functions before every shell command, as the cohort Snakefile does, so that rules can
# activate the SQANTI and SQANTI-browser environments. PS1 is set empty first, because conda activate reads it
# under bash strict mode and a batch job does not set it.
shell.prefix(
    'export PS1=""; '
    'ml anaconda3; '
    'CONDA_BASE=$(conda info --base); '
    'source $CONDA_BASE/etc/profile.d/conda.sh; '
    'module purge; '
    'conda activate isoseq-pipeline; '
)

# This Snakefile sits in isoseq-pipeline/cross_cohort/, so the isoseq scripts and workflows are one folder up.
# The salmon-pipeline gffread wrapper sits next to isoseq-pipeline in pipelines/.
ISOSEQ_DIR    = os.path.dirname(workflow.basedir)
PIPELINES_DIR = os.path.dirname(ISOSEQ_DIR)
SCRIPTS       = os.path.join(ISOSEQ_DIR, "scripts")
FASTA_SH      = os.path.join(PIPELINES_DIR, "salmon-pipeline/scripts/make_transcriptome_fasta.sh")
SQANTI_RULES  = os.path.join(ISOSEQ_DIR, "misc", "sqanti_rules.json")
# Tools: tama_merge (which needs Python 2) and gffcompare 0.12.10.
TAMA       = "/sc/arion/projects/ad-omics/data/software/tama/tama_merge.py"
PYTHON2    = "/sc/arion/projects/als-omics/conda/envs/tama_env/bin/python"
GFFCOMPARE = "/sc/arion/projects/ad-omics/data/software/gffcompare-0.12.10.Linux_x86_64/gffcompare"

# Every name tied to the build comes from run_code, so a new build cannot read or overwrite an old one.
RUN  = config["run_code"]
OUT  = config["reference_root"] + RUN + "/"
NAME = "isoforms_" + RUN

# Read each cohort's own config, so that this stage takes its genome, its assembler output paths and its short-read
# junction files from the same file the cohort run used.
COHORT_CFG = {}
for cohort_name, cohort_config in config["cohorts"].items():
    with open(cohort_config) as fh:
        COHORT_CFG[cohort_name] = yaml.safe_load(fh)
COHORT_NAMES = sorted(COHORT_CFG)

# Stop when a cohort name carries an underscore, because TAMA and the membership columns use it as a separator.
# Stop also when a cohort config names another run_code, so that one build never mixes the outputs of two.
for cohort_name, cfg in COHORT_CFG.items():
    if "_" in cohort_name:
        raise ValueError("cohort name %s carries an underscore" % cohort_name)
    if cfg["run_code"] != RUN:
        raise ValueError("cohort %s has run_code %s, this build is %s" % (cohort_name, cfg["run_code"], RUN))

# The cohorts must share the genome, the annotation and the SQANTI evidence files, because one SQANTI run and one
# reference cover them all. The positive-control coordinates and the UCSC genome name are optional in a cohort
# config. When absent they take the hg38 values below, and they must also agree between cohorts.
# The hg38 UNC13A event needs both junctions on either side of its cryptic exon.
HG38_SANITY_EVENTS = ("UNC13A:chr19:17641557-17642413+17642542-17642844,"
                      "STMN2:chr8:79611215-79616821,"
                      "KCNQ2:chr20:63439709-63444658,"
                      "HYOU1:chr11:119052173-119052636,"
                      "NUP93:chr16:56839070-56841704,"
                      "XPNPEP1:chr10:109884149-109888048")
SHARED = {}
for key, default in (("ref_genome", None), ("ref_gtf", None), ("sqanti_cage_peak", None),
                     ("sqanti_polya_motifs", None), ("sanity_event_list", HG38_SANITY_EVENTS),
                     ("ucsc_genome", "hg38")):
    values = {cfg.get(key, default) for cfg in COHORT_CFG.values()}
    if len(values) != 1 or None in values:
        raise ValueError("the cohort configs disagree on %s: %s" % (key, values))
    SHARED[key] = values.pop()
GENOME        = SHARED["ref_genome"] + ".fa"
REF_GTF       = OUT + "reference.gtf"
SANITY_GENES  = "UNC13A,STMN2,KCNQ2,HYOU1,NUP93,XPNPEP1"
SANITY_EVENTS = SHARED["sanity_event_list"]


# List the assembler GTFs as (tool, cohort, group, path), with the paths the cohort pipeline writes.
def cohort_tool_gtfs(cohort_name, cfg):
    out = cfg["out_folder"] + cfg["run_code"] + "/"
    code = cfg["data_code"]
    rows = []
    for g in cfg["groups"]:
        rows.append(("bambu", cohort_name, g, out + "bambu/%s/%s_%s_extended_annotations.gtf" % (g, code, g)))
        rows.append(("isoquant", cohort_name, g,
                     out + "isoquant/%s/%s_%s/%s_%s.extended_annotation.gtf" % (g, code, g, code, g)))
        rows.append(("stringtie", cohort_name, g, out + "stringtie3/%s/%s_%s.stringtie.gtf" % (g, code, g)))
    return rows


TOOL_GTFS = [row for c in COHORT_NAMES for row in cohort_tool_gtfs(c, COHORT_CFG[c])]


# List the STAR junction files that SQANTI uses for short-read support, from both cohorts. A library in a cohort's
# exclude_samples stays out, as it stays out of that cohort's minimap2 hints and StringTie short-read pool (tdpkd
# TDP-5 and CTRL-4). The sample id is the part of the file name before the first dot, as in <sample>.SJ.out.tab.
def cohort_sj_files(cfg):
    excluded = {x for x in cfg.get("exclude_samples", "").split(",") if x}
    return [f for f in sorted(glob.glob(os.path.join(cfg["junction_folder"], "*.SJ.out.tab")))
            if os.path.basename(f).split(".")[0] not in excluded]


SQANTI_SJ = [f for c in COHORT_NAMES for f in cohort_sj_files(COHORT_CFG[c])]
# SQANTI names each library by its file name, so two cohorts with the same library name would be counted as one
# library. Stop if that happens.
sj_names = [os.path.basename(f) for f in SQANTI_SJ]
if len(set(sj_names)) != len(sj_names):
    raise ValueError("two cohorts share a junction file name: %s" % sorted(sj_names))

# The final outputs. The tracking table is updated only when the config names it.
rule all:
    input:
        OUT + NAME + ".gtf.gz",
        OUT + NAME + ".fa.gz",
        OUT + "cross_cohort_novel_provenance.tsv",
        OUT + NAME + "_sanity_genes.tsv",
        OUT + "consensus/" + NAME + "_tool_overlap.tsv",
        OUT + "tracking_numbers_final_numbers.tsv",
        expand(OUT + "tracking_numbers_{cohort}.tsv", cohort=COHORT_NAMES),
        OUT + "sqanti/" + NAME + "_ucsc_hub",
        [OUT + "tracking_numbers.done"] if config.get("tracking_numbers") else []


# Decompress the reference, because gffcompare, SQANTI and the scripts read a plain-text GTF.
rule decompress_reference:
    input:
        SHARED["ref_gtf"]
    output:
        temp(REF_GTF)
    shell:
        "gunzip -c {input} > {output}"


# The rules of the pooled stage. rule all above stays the first rule, so it is the default target.
include: os.path.join(ISOSEQ_DIR, "workflows", "consensus_pipeline.smk")
include: os.path.join(ISOSEQ_DIR, "workflows", "sqanti_pipeline.smk")
